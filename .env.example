# Copy to .env.local and fill in. Never commit .env.local.

# NVIDIA build.nvidia.com — server only, never expose to the browser
NVIDIA_API_KEY=
# Optional spare keys, rotated to on rate limits (429)
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_API_KEY_4=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — bypasses RLS, used for seeding and admin jobs
SUPABASE_SERVICE_ROLE_KEY=
